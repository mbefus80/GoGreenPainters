# Netlify cache + security headers
# https://docs.netlify.com/routing/headers/

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=()

# CSS & JS: stable filenames that change often. Must NOT be immutable —
# immutable caused browsers to serve a months-old styles.css forever.
# Always revalidate; cache-busting is handled by the ?v= query param in the HTML.
/*.css
  Cache-Control: public, max-age=0, must-revalidate

/*.js
  Cache-Control: public, max-age=0, must-revalidate

# Images & fonts: change rarely, but filenames are stable so NOT immutable.
# One-week cache, then revalidate (cheap 304 if unchanged).
/*.jpg
  Cache-Control: public, max-age=604800

/*.jpeg
  Cache-Control: public, max-age=604800

/*.png
  Cache-Control: public, max-age=604800

/*.webp
  Cache-Control: public, max-age=604800

/*.svg
  Cache-Control: public, max-age=604800

/*.woff2
  Cache-Control: public, max-age=604800

/*.woff
  Cache-Control: public, max-age=604800

# HTML pages — short cache so updates roll out quickly
/*.html
  Cache-Control: public, max-age=300, must-revalidate

# Root document
/
  Cache-Control: public, max-age=300, must-revalidate
